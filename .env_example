# ============================================================
# ARC Configuration Example
# ============================================================
# Copy this file to .env and fill in your values.
# Configuration priority: shell env > ARC_ENV_FILE > ./.env

# ============================================================
# Required for the built-in backend: OpenAI-compatible API endpoint
# ============================================================
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Required for the built-in backend: Main coding model
# Examples: gpt-4o, gpt-4-turbo, claude-3-5-sonnet (via compatible endpoint)
MODEL=gpt-4o

# Required for the built-in backend: API mode for OpenAI-compatible endpoints
# - "chat_completions": Use /v1/chat/completions endpoint (default, most compatible)
# - "responses": Use /v1/responses endpoint (for models that support it)
ARC_OPENAI_API_MODE=chat_completions

# ============================================================
# Optional: Visual analysis for screenshots and UI references
# ============================================================
# Leave empty to skip visual analysis or reuse main model settings
VISUAL_API_KEY=
VISUAL_BASE_URL=
VISUAL_MODEL=

# ============================================================
# Optional: Debug and tuning
# ============================================================
# ARC_DEBUG: Enable detailed logging to workspace/.arc/debug.log
# - 0 or empty: disabled (default)
# - 1: enabled
ARC_DEBUG=0

# ARC_STRUCTURED_OUTPUT_RETRY_COUNT: Retry budget when agent output parsing fails
# Default: 2
ARC_STRUCTURED_OUTPUT_RETRY_COUNT=2

# ============================================================
# Optional: Local Octos agent backend
# ============================================================
# Use Octos instead of ARC's built-in model backend for interface design,
# test generation, and test-driven implementation. OPENAI_* and MODEL are
# then only needed for ARC-owned visual analysis when no VISUAL_* override
# is configured.
# ARC_AGENT_BACKEND=octos-local
# OCTOS_BIN=/absolute/path/to/octos

# Legacy compatibility switch; prefer ARC_AGENT_BACKEND above.
# ARC_OCTOS_LOCAL=0

# Local Octos MCP tuning (defaults shown)
# OCTOS_MCP_CONTRACT=coding
# OCTOS_MCP_TIMEOUT=1800
# OCTOS_MCP_STARTUP_TIMEOUT=30

# ============================================================
# Optional: Custom environment file path
# ============================================================
# ARC_ENV_FILE: Point to a different .env file
# Example: ARC_ENV_FILE=~/.arc/global.env
# ARC_ENV_FILE=
